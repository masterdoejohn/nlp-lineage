---
// Search runs in the browser over the Pagefind index (built after the site: npm run site:build).
// It covers milestone, thread and glossary pages. The query is kept in the address (?q=), so a search can be shared.
import Base from '../layouts/Base.astro';
---
<Base title="Search" description="Search the milestones, threads and glossary.">
  <h1 class="title">Search</h1>
  <form class="search-box sec" id="search-form" action="/search/" method="get" role="search">
    <label for="q">Search milestones, threads and terms</label>
    <div class="sb-row">
      <input id="q" name="q" type="search" autocomplete="off" spellcheck="false" />
      <button class="btn btn-ink" type="submit">Search</button>
    </div>
  </form>
  <p class="f-count" id="s-status" role="status"></p>
  <ol class="results" id="results"></ol>
  <button class="btn" id="more" type="button" hidden>Show more results</button>
  <noscript><p class="status">Search needs JavaScript. You can still <a href="/milestones/">browse every milestone</a>, the <a href="/timeline/">timeline</a> or the <a href="/threads/">threads</a>.</p></noscript>
</Base>

<script>
  type Data = { url: string; excerpt: string; meta: { title?: string; sub?: string } };
  const form = document.getElementById('search-form') as HTMLFormElement;
  const input = document.getElementById('q') as HTMLInputElement;
  const status = document.getElementById('s-status')!;
  const list = document.getElementById('results')!;
  const more = document.getElementById('more') as HTMLButtonElement;
  const PAGE = 20;
  let pagefind: any = null, hits: { data: () => Promise<Data> }[] = [], shown = 0, seq = 0;

  async function load() {
    if (pagefind) return pagefind;
    const path = '/pagefind/pagefind.js';
    pagefind = await import(/* @vite-ignore */ path);
    await pagefind.init();
    return pagefind;
  }
  async function showNext() {
    const mine = seq;
    const batch = await Promise.all(hits.slice(shown, shown + PAGE).map((h) => h.data()));
    if (mine !== seq) return;
    for (const d of batch) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = d.url; a.className = 'r-title'; a.textContent = d.meta.title ?? d.url;
      li.append(a);
      if (d.meta.sub) { const s = document.createElement('span'); s.className = 'r-sub'; s.textContent = d.meta.sub; li.append(s); }
      const p = document.createElement('p'); p.className = 'r-ex'; p.innerHTML = d.excerpt;  // Pagefind's excerpt of our own pages, with <mark>
      li.append(p);
      list.append(li);
    }
    shown += batch.length;
    more.hidden = shown >= hits.length;
  }
  async function run(q: string) {
    const mine = ++seq;
    list.textContent = ''; shown = 0; hits = []; more.hidden = true;
    history.replaceState(null, '', q ? `?q=${encodeURIComponent(q)}` : location.pathname);
    if (!q.trim()) { status.textContent = ''; return; }
    status.textContent = 'Searching.';
    try {
      const pf = await load();
      const res = await pf.debouncedSearch(q, {}, 200);
      if (mine !== seq || res === null) return;
      hits = res.results;
      status.textContent = hits.length ? `${hits.length} result${hits.length === 1 ? '' : 's'} for "${q}".` : `No results for "${q}".`;
      await showNext();
    } catch {
      if (mine === seq) status.textContent = 'Search is not available here. The search index is made when the site is built.';
    }
  }
  form.addEventListener('submit', (e) => { e.preventDefault(); run(input.value); });
  input.addEventListener('input', () => run(input.value));
  more.addEventListener('click', showNext);
  const q0 = new URLSearchParams(location.search).get('q') ?? '';
  input.value = q0;
  if (q0) run(q0);
</script>
