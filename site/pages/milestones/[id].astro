---
import Base from '../../layouts/Base.astro';
import RelList from '../../components/RelList.astro';
import Lineage from '../../components/Lineage.astro';
import { milestones, threadById, chapterByN, study, phases, incoming, outgoing, termsFor, type Milestone } from '../../lib/data';
import { when, cap, access, host, claimFlag, levelReason } from '../../lib/labels';
import { influence } from '../../lib/lineage';
import { linkTerms } from '../../lib/glossary';

export function getStaticPaths() {
  return milestones.map((m) => ({ params: { id: m.id }, props: { m } }));
}
const { m } = Astro.props as { m: Milestone };
const home = threadById[m.lines[0]];
const chap = chapterByN[m.ch];
const st = study[m.id];
const inf = influence(m.id);
const flags = [claimFlag(m)].filter(Boolean);
const ins = incoming(m.id), outs = outgoing(m.id);
const terms = termsFor(m.id);
// glossary links: the first mention of each of this milestone's terms, in reading order
const linked = new Set<string>();
const story = ([['Before it', m.before], ['The problem', m.problem], ['What it introduced', m.breakthrough], ['Why it matters', m.why], ['What modern models inherit', m.inherits], ['What came next', m.next]] as [string, string][])
  .map(([h, t]) => [h, linkTerms(t, terms, linked)] as [string, string]);
const facts: [string, string][] = [
  ['Date', when(m)],
  ['What the date marks', m.dtype.startsWith('arXiv') ? m.dtype : cap(m.dtype)],
  ['Kind', cap(m.type)],
  ['Organisation', m.inst],
  ['Access', access(m)],
];
if (m.other) facts.push(['Other dates', m.other]);
---
<Base title={m.short} description={m.problem} indexed>
  <header class="field" data-pagefind-meta={`sub:${when(m)}, ${cap(m.type)}`} style={`--c:var(--c-${home.id});--on:var(--on-${home.id})`}>
    <p class="meta" data-pagefind-ignore>{when(m)} · {home.name}</p>
    <h1 class="title">{m.short}</h1>
  </header>

  <div class="under-field">
    <p class="orig">{m.title}</p>
    <p class="by">{m.authors}</p>

    <dl class="facts">
      {facts.map(([k, v]) => <div><dt>{k}</dt>{' '}<dd>{v}</dd></div>)}
      <div>
        <dt>Threads</dt>{' '}
        <dd><ul class="marks">{m.lines.map((l) => <li><a class="mark" style={`--c:var(--c-${l})`} href={`/threads/${l}/`}>{threadById[l].name}</a></li>)}</ul></dd>
      </div>
      <div><dt>In the guided tour</dt>{' '}<dd><a href={`/tour/#ch-${chap.n}`}>Chapter {chap.n}. {chap.title}</a></dd></div>
      {m.phase.length > 0 && (
        <div><dt>Learning phases</dt>{' '}<dd>{m.phase.map((p) => `${p}. ${phases[String(p)]}`).join('; ')}</dd></div>
      )}
    </dl>

    <div class="flags">
      <p class="flag" data-level={m.level}>{levelReason(m, inf.direct, inf.threads)} <a href="/levels/">How levels are decided</a></p>
      {flags.map((f) => <p class="flag">{f}</p>)}
    </div>

    <div class="actions">
      <a class="btn btn-ink" href={m.src} rel="noopener">Read the primary source ({host(m.src)})</a>
    </div>

    <p class="status">Full summary in progress. Until then, this page shows the milestone's record from the research data.</p>
  </div>

  <section class="sec" aria-labelledby="h-story">
    <h2 id="h-story">What it changed</h2>
    <div class="story">
      {story.map(([h, html]) => <div><h3>{h}</h3><p set:html={html} /></div>)}
    </div>
  </section>

  {st && (
    <section class="sec" aria-labelledby="h-learn">
      <h2 id="h-learn">To understand it</h2>
      <div class="story">
        <div><h3>Learn</h3><ul class="prose" style="padding-left:1.2em">{st.understand.map((u) => <li>{u}</li>)}</ul></div>
        <div><h3>Helpful first</h3><p>{st.prereq}</p></div>
      </div>
    </section>
  )}

  <section class="sec" aria-labelledby="h-lin" data-pagefind-ignore>
    <h2 id="h-lin">Before and after</h2>
    <p class="lead small muted" style="margin:0 0 var(--s5)">The milestones it descends from, and the milestones that descend from it. Work developed alongside it is not counted. Weak links are left out unless you include them.</p>
    <div class="rels">
      <div><h3 class="h3">Before: where it came from</h3><Lineage id={m.id} dir="before" /></div>
      <div><h3 class="h3">After: what it led to</h3><Lineage id={m.id} dir="after" /></div>
    </div>
  </section>

  <section class="sec" aria-labelledby="h-rel" data-pagefind-ignore>
    <h2 id="h-rel">Direct links and their sources</h2>
    <div class="rels">
      <div><h3 class="h3">Where it came from</h3><RelList rels={ins} dir="in" /></div>
      <div><h3 class="h3">What it led to</h3><RelList rels={outs} dir="out" /></div>
    </div>
  </section>

  {terms.length > 0 && (
    <section class="sec" aria-labelledby="h-terms">
      <h2 id="h-terms">Terms</h2>
      <ul class="marks">{terms.map((t) => <li><a href={`/glossary/${t.id}/`}>{t.term}</a></li>)}</ul>
    </section>
  )}
</Base>
