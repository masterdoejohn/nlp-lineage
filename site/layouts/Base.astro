---
// Every page of the reference site. Tokens come from src/tokens.css, shared with the guided tour.
import '../../src/tokens.css';
import '../styles/site.css';

// indexed: the page's main content goes into the search index (milestone, thread and glossary pages)
interface Props { title: string; description: string; indexed?: boolean }
const { title, description, indexed = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['/milestones/', 'Milestones'],
  ['/timeline/', 'Timeline'],
  ['/threads/', 'Threads'],
  ['/glossary/', 'Glossary'],
  ['/learn/', 'Learning path'],
  ['/tour/', 'Guided tour'],
  ['/search/', 'Search'],
];
const fullTitle = title === 'NLP Lineage' ? title : `${title} · NLP Lineage`;
// "Report a problem" opens a new GitHub issue with the page's address filled in. Nothing about the reader is sent.
const pageUrl = new URL(path, Astro.site).href;
const issue = 'https://github.com/masterdoejohn/nlp-lineage/issues/new?' + new URLSearchParams({
  title: `Problem on ${title}`,
  body: `Page: ${pageUrl}

What is wrong:


A source that shows the correct information, if you have one:
`,
}).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="bar">
      <div class="sheet bar-in">
        <a class="brand" href="/">NLP Lineage</a>
        <nav aria-label="Sections">
          <ul>
            {nav.map(([href, label]) => (
              <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="sheet" data-pagefind-body={indexed ? '' : undefined}>
      <slot />
    </main>
    <footer class="foot">
      <div class="sheet">
        <p>Every milestone and relationship comes from a primary source, linked on its page. Weak links are marked as weak.</p>
        <p>Content: <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener">CC BY 4.0</a>, Zeeshan Arif. Code: <a href="https://github.com/masterdoejohn/nlp-lineage/blob/main/LICENSE" rel="noopener">MIT licence</a>.</p>
        <ul class="foot-links">
          <li><a href="/about/">About this site</a></li>
          <li><a href={issue} rel="noopener" data-report>Report a problem on this page</a></li>
          <li><a href="https://github.com/masterdoejohn/nlp-lineage" rel="noopener">Source on GitHub</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
